{
  "name": "sla-pengajuan-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test:e2e:workflow": "tsx src/scripts/e2e-workflow-timer.ts",
		"test:e2e:notifications": "tsx src/scripts/e2e-notifications.ts",
		"test:e2e:management": "tsx src/scripts/e2e-management-dashboard.ts",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:bootstrap-admin": "tsx src/db/bootstrap-admin.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
